<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/SQL/pizzasales/dataset1/dataset1.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="676"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title=".Browsables" custom_title="0" dock_id="1" table="4,7:maindataset"/><dock_state state="000000ff00000000fd00000001000000020000043c000002b4fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000043c0000015c00ffffff0000043c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="dataset" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="107"/><column index="3" value="116"/><column index="4" value="124"/><column index="5" value="102"/><column index="6" value="126"/><column index="7" value="98"/><column index="8" value="121"/><column index="9" value="48"/><column index="10" value="104"/><column index="11" value="96"/><column index="12" value="130"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">select * from pizza_sales;
--filter baseed on medium size 

select * from pizza_sales where pizza_size=&quot;M&quot;;

--total orders 
select count(distinct order_id)from pizza_sales;

--total revenue
select sum(total_price)as total_revenue from pizza_sales;

--total sales
select sum(quantity)as total_sales from pizza_sales;

--average ORDER
select sum(total_price)/count(distinct order_id)as average_order from pizza_sales;

--average pizza sold per_order
select sum(quantity)/count(distinct order_id)as average_order from pizza_sales;

--cast()--converts one datatype to another 
select round(cast(sum(total_price)as real)/count(distinct order_id),3)as  average_order from pizza_sales;


select round(cast(sum(quantity)as real),2)/round(cast(count(distinct order_id)as real),2) as average_order from pizza_sales;

--daily trends on orders
select datename(dw,order_date)as order_day count(distinct order_id)as total_order from pizza_sales group by datename(dw,order_date);

select order_date from pizza_sales;

select  CASE
strftime ('%w',
substr(order_date,7,4)||'-'||
substr(order_date,4,2)||'-'||
substr(order_date,1,2))
    
	      when '0' then 'Sunday'
		  when '1' then 'Monday'
		  when '2' then 'Tuesday'
		  when '3' then 'Wednesday'
		  when '4' then 'Thursday'
		  when '5' then 'Friday'
		  when '6' then 'Saturday'
		  end as order_day,
		  count(distinct order_id)as total_order from pizza_sales group by order_day order by total_order desc;
		  
		
--monthly trend on orders
select datename(month,order_date),as order_dat count (
		  
select 
case strftime('%m',
substr(order_date,7,4)||'-'||
substr(order_date,1,2)||'-'||
substr(order_date,4,2))
		  when '0' then 'jan'
		  when '1' then 'feb'
		  when '2' then 'mar'
		  when '3' then 'april'
		  when '4' then 'may'
		  when '5' then 'june'
		  when '6' then 'july' 
          when '7' then 'august'
		  when '8' then 'sep'
		  when '9' then 'oct'
		  when '10' then 'nov'
		  when '11' then 'dec'
		  
        end as   order_month,
		count(distinct order_id)as total_order from pizza_sales group by order_month order by total_order desc;
		

--find the quantity sold in each category
select pizza_category,sum(quantity)as total_sales from pizza_sales group by pizza_category order by total_sales desc;

--find the revenue in each category
select pizza_category,sum(total_price)as total_revenue from pizza_sales group by pizza_category order by total_revenue desc;


--hourly orders
select datepart(hour,order_time)as order_hour count(distinct order_id) as total_orders from pizza_sales group by datepart (hour,order_time)order by total_orders desc;

select strftime('%H',order_time) as order_hour,
count(distinct order_id) as total_orders
	from pizza_sales
	group by strftime ('%H',order_time)
	order by total_orders desc;
	
	
--total pizza sold by pizza_name
select pizza_name,sum(quantity)as total_pizza_sold from pizza_sales group by pizza_name order by total_pizza_sold desc;

--top3 months based on orders
select 
case substr(order_date,1,2)
	      when '0' then 'jan'
		  when '1' then 'feb'
		  when '2' then 'mar'
		  when '3' then 'april'
		  when '4' then 'may'
		  when '5' then 'june'
		  when '6' then 'july' 
          when '7' then 'august'
		  when '8' then 'sep'
		  when '9' then 'oct'
		  when '10' then 'nov'
		  when '11' then 'dec'
		    
        end as   order_month,
		count(distinct order_id) as total_orders from pizza_sales group by order_month order by total_order desc limit 3 ;
	
--task
--bottom 3 months based on orders

--top 5 pizza names based on sales
SELECT pizza_name, SUM(quantity) AS total_sales
FROM pizza_sales
GROUP BY pizza_name
ORDER BY total_sales DESC
LIMIT 5;

--top 5 pizza names based on revenue
SELECT pizza_name, SUM(total_price) AS total_revenue
FROM pizza_sales
GROUP BY pizza_name
ORDER BY total_revenue DESC
LIMIT 5;

--total orders by pizza_size
SELECT pizza_size, COUNT(DISTINCT order_id) AS total_orders
FROM pizza_sales
GROUP BY pizza_size
ORDER BY total_orders DESC;

--top 5 best selling pizza by orders
SELECT pizza_name, COUNT(DISTINCT order_id) AS total_orders
FROM pizza_sales
GROUP BY pizza_name
ORDER BY total_orders DESC
LIMIT 5;



select 	  
case substr(order_date,1,2)
          when '0' then 'jan'
		  when '1' then 'feb'
		  when '2' then 'mar'
		  when '3' then 'april'
		  when '4' then 'may'
		  when '5' then 'june'
		  when '6' then 'july' 
          when '7' then 'august'
		  when '8' then 'sep'
		  when '9' then 'oct'
		  when '10' then 'nov'
		  when '11' then 'dec'
		  end as order_month,
		  count(distinct order_id) as total_orders from pizza_sales group by order_month order by total_orders asc limit 3;
		  
--date related QUERY
--extract year
select 
order_date,
substr(order_date,7,4)as order_year from pizza_sales;

--make permanent COLUMN
alter table pizza_sales 
add column order_year;

select * from pizza_sales;

add order_year int;



--update
update pizza_sales set order_year=substr(order_date,7,4);
select order_date,order_year from pizza_sales;

--all date related value extraction

SELECT
order_date,
substr(order_date,7,4)as order_year ,
substr(order_date,4,2)as month_number ,
case substr(order_date,1,2)
          when '0' then 'jan'
		  when '1' then 'feb'
		  when '2' then 'mar'
		  when '3' then 'april'
		  when '4' then 'may'
		  when '5' then 'june'
		  when '6' then 'july' 
          when '7' then 'august'
		  when '8' then 'sep'
		  when '9' then 'oct'
		  when '10' then 'nov'
		  when '11' then 'dec'
		  end as month_name,
		  
substr(order_date,4,2)as day_number  ,
case strftime('%w',
substr(order_date,7,4)||'-'||
substr(order_date,1,2)||'-'||
substr(order_date,4,2))
          when '0' then 'Sunday'
		  when '1' then 'Monday'
		  when '2' then 'Tuesday'
		  when '3' then 'Wednesday'
		  when '4' then 'Thursday'
		  when '5' then 'Friday'
		  when '6' then 'Saturday'
end as day_name
 from pizza_sales;
 
--pizza sales – Window funcons task 
--1. Find the average total price of all pizzas and display it along with every pizza record. 
select pizza_name,total_price ,avg(total_price)over()as overall_avg_price from pizza_sales;

--2. Find the total sales revenue and display it along with every pizza record. 
select pizza_name,total_price,sum(total_price)over()as total_revenue from pizza_sales;

--3. Find the maximum unit price among all pizzas and display it along with every pizza record. 
select pizza_name,total_price ,max(unit_price)over()as max_unit_price from pizza_sales;

--4. Find the average total price for each pizza category and display it for every pizza. 
select pizza_category,total_price,avg(total_price) over(partition by pizza_category) as avg_price from pizza_sales;

--5. Find the total revenue for each pizza category and display it for every pizza. 
select pizza_name,pizza_category,total_price,sum(total_price) over(partition by pizza_category) as total_revenue from pizza_sales;

--6. Find the number of pizza records for each pizza size and display it for every pizza.
select pizza_name,pizza_size,count(*)over(partition by pizza_size) as pizza_record from pizza_sales;

--7. Assign a unique row number to every pizza based on total price from highest to lowest.
select pizza_name,total_price,row_number() over (order by total_price desc) as row_number from pizza_sales;
 
--8. Rank all pizzas based on total price from highest to lowest. 
select pizza_name,total_price,rank()over(order by total_price desc)as rank from pizza_sales;

--9. Assign a dense rank to all pizzas based on total price from highest to lowest. 
select pizza_name,total_price,dense_rank() over(order by total_price desc) as dense_rank from pizza_sales;

--10. Rank pizzas based on total price within each pizza category. 
select pizza_name,total_price,pizza_category,rank() over(partition by pizza_category order by total_price desc) as rank from pizza_sales;

--11. Find the highest-priced pizza in each pizza category. 
select pizza_name,total_price,pizza_category,rank() over(partition by pizza_category order by total_price desc) as highest_priced_rank from pizza_sales;


--12. Find the top 2 highest-priced pizzas from each pizza category. 
select pizza_name, total_price, pizza_category from (
select pizza_name, total_price, pizza_category,
rank() over(partition by pizza_category order by total_price desc) as rank
from pizza_sales
)
where rank &lt;= 2;


--13. Display each pizza's total price along with the previous pizza's total price. 
select pizza_name, total_price,LAG(total_price) over (order by  total_price)as previous_price from pizza_sales;

--14. Find the difference between the current pizza's total price and the previous pizza's total price. 
select  pizza_name, total_price, total_price - LAG(total_price) over (order by total_price) as difference from pizza_sales

--15. Display each pizza's unit price along with the previous pizza's unit price.
SELECT pizza_name, unit_price,
       LAG(unit_price) OVER (ORDER BY unit_price) AS previous_unit_price
FROM pizza_sales;

--16. Display each pizza's total price along with the next pizza's total price. 
SELECT pizza_name, total_price,
       LEAD(total_price) OVER (ORDER BY total_price) AS next_total_price
FROM pizza_sales;


--17. Find the difference between the current pizza's total price and the next pizza's total price. 
SELECT pizza_name, total_price,
       total_price - LEAD(total_price) OVER (ORDER BY total_price) AS difference
FROM pizza_sales;


--18. Display each pizza's unit price along with the next pizza's unit price.
SELECT pizza_name, unit_price,
       LEAD(unit_price) OVER (ORDER BY unit_price) AS next_unit_price
FROM pizza_sales;

 
--19. Create a pizza_type column using pizza_category:  
--a. Classic → Regular  
--b. Veggie → Vegetarian  
--c. Chicken → Non-Vegetarian  
--d. Supreme → Special 
select pizza_name,pizza_category,
case
WHEN pizza_category = 'Classic' THEN 'Regular'
WHEN pizza_category = 'Veggie' THEN 'Vegetarian'
WHEN pizza_category = 'Chicken' THEN 'Non-Vegetarian'
WHEN pizza_category = 'Supreme' THEN 'Special'
end as pizza_type from pizza_sales;

--20. Categorize pizzas based on unit_price:  
--a. Below 15 → Budget  
--b. 15–20 → Standard  
--c. Above 20 → Premium 
select pizza_name,unit_price,
CASE
    WHEN unit_price &lt; 15 THEN 'Budget'
    WHEN unit_price BETWEEN 15 AND 20 THEN 'Standard'
    WHEN unit_price &gt; 20 THEN 'Premium'
END as pizza_category from pizza_sales;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
